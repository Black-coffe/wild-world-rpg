#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values for each setting
# 3. NEVER commit the .env file to version control
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = your_database_password
database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# Test database (for PHPUnit tests)
# database.tests.hostname = localhost
# database.tests.database = your_test_database
# database.tests.username = your_database_user
# database.tests.password = your_database_password
# database.tests.DBDriver = MySQLi

#--------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
#--------------------------------------------------------------------

# Get your bot token from @BotFather on Telegram
telegram.API_KEY = 'YOUR_TELEGRAM_BOT_TOKEN'

# Your bot username (with @ symbol)
telegram.BOT_USERNAME = '@your_bot_username'

# Webhook URL for your bot (must be HTTPS in production)
telegram.HOOK_URL = 'https://your-domain.com/telegram/webhook'

# Your Telegram chat ID for admin notifications
telegram.MY_CHAT_ID = 'YOUR_TELEGRAM_CHAT_ID'

# Optional: shared secret between this app and Telegram for webhook
# verification. If set, BotController::webhook will reject requests whose
# X-Telegram-Bot-API-Secret-Token header doesn't match (returns 403).
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Then re-register the webhook with:
#   curl -X POST https://api.telegram.org/bot<TOKEN>/setWebhook \
#        -d "url=https://your-domain.com/telegram/webhook" \
#        -d "secret_token=<this-value>"
# Leave empty to skip verification (legacy / dev). See F0.9 in
# mmorpg-vault/lore/refactor/Security-telegram.md.
# telegram.WEBHOOK_SECRET = ''

#--------------------------------------------------------------------
# EMAIL / SMTP CONFIGURATION
#--------------------------------------------------------------------

email.fromEmail = 'noreply@your-domain.com'
email.SMTPHost = 'smtp.your-email-provider.com'
email.SMTPUser = 'your-smtp-username'
email.SMTPPass = 'your-smtp-password'
email.SMTPPort = 587

#--------------------------------------------------------------------
# ADMIN USER (for initial migration)
#--------------------------------------------------------------------

# These are used when running the admin user migration
# IMPORTANT: Change these values before running migrations!
admin.email = 'admin@your-domain.com'
admin.password = 'ChangeThisSecurePassword123!'

#--------------------------------------------------------------------
# CONTENT SECURITY POLICY
#--------------------------------------------------------------------

# contentsecuritypolicy.reportOnly = false
# contentsecuritypolicy.defaultSrc = 'none'
# contentsecuritypolicy.scriptSrc = 'self'
# contentsecuritypolicy.styleSrc = 'self'
# contentsecuritypolicy.imageSrc = 'self'

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate a secure key for encryption
# You can use: php spark key:generate
# encryption.key =

