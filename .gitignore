#-------------------------
# Security - Additional
#-------------------------
# Credential files
auth.json
.composer/auth.json

# Google service-account key (GSC SEO-пайплайн, Config\Seo) — НИКОГДА в git.
writable/secrets/

# Локальные выгрузки семантики (Bukvarix scrape, research) — не в git.
writable/bukvarix/

# Локальные обложки постов сайта (генерятся throwaway site:cover-gen → scp на прод) — не в git.
writable/site-covers/

# Артефакты внешних публикаций (Хабр/Пикабу posting-kit'ы + обложки/мемы, обложки уже на проде;
# posting-kit нужен владельцу для ручной вёрстки) — throwaway, не в git.
writable/habr*/
writable/dtf*/
writable/pikabu-covers/

# Одноразовые SQL-скрипты миграций-состояния (применяются на проде вручную, аудит в daily/ADR) — не в git.
writable/*.sql

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub

# Log files that may contain sensitive data
*.log

#-------------------------
# Claude Code / AI Tools (ADR-170: VULYK — рамка оркестрации)
#-------------------------
# До установки VULYK каталог игнорировался целиком, из-за чего каждая машина
# (ПК <-> ноутбук) держала свою копию агентов, хуков и скиллов вручную — тот же
# перекос, ради которого settings.local.json пришлось дублировать в ADR-087.
# Теперь по умолчанию игнорируется ВСЁ содержимое, а рамка (агенты, команды,
# хуки, правила, скиллы, общие настройки) явно возвращается в трекинг и едет
# в git вместе с кодом. Секреты, per-machine и runtime — остаются вне git.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/rules/
!.claude/skills/
!.claude/settings.json
!.claude/vulyk-version

# community-chat-bot ADR-176/story-13: локальный pull-inbox с сырым текстом переписки
# игроков (открытые вопросы, треды). Уже накрыт правилом `.claude/*` выше — строка ниже
# оставлена явной, чтобы намерение не зависело от списка исключений над ней.
.claude/community/

#-------------------------
# Misc Artifacts
#-------------------------
nul
*.patch


#-------------------------
# Image pipeline (ADR-022) — локальные бэкапы оригиналов перед регенерацией.
# Архив оригиналов = git-история (коммит до ребренда) + offline zip; в прод не нужно.
#-------------------------
public/uploads/telegram/_legacy/
app/Commands/SmokeS26b.php

#-------------------------
# Website CMS (ADR-052) — featured-картинки импортируются командой site:import-wp
# на каждом окружении вместе с DB-строками постов (контент = данные в БД, не в git).
#-------------------------
public/uploads/site/

#-------------------------
# Локальные превью-черновики public/*-preview.html: рабочие макеты, которые живут
# у автора на диске и не должны уезжать в релиз. Дважды (12.08.2026) утаскивались
# в коммит через `git add -A` вместе с несвязанными правками — проще игнорировать,
# чем вычищать из индекса каждый раз. Живые UI-kit'ы (ui-kit.html,
# admin-redesign-preview.html) в репозитории ОСТАЮТСЯ — они часть дизайн-системы.
#-------------------------
public/webgame-preview.html

# Личные карты исследованного (App\Services\World\ExploredMapService) — генерятся на лету
writable/tmp_map/*
!writable/tmp_map/index.html

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
# Каталог .claude/ уже закрыт правилом `.claude/*` выше — runtime-артефакты улья
# (handoff/, .vulyk-update-cache, state.json, settings.local.json, *.vulyk-bak)
# под него подпадают и отдельных строк не требуют.
CLAUDE.local.md
memory/snapshots/
memory/map/.stale
__pycache__/
